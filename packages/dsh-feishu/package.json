{
  "name": "dsh-feishu",
  "version": "0.1.0-alpha.1",
  "description": "Workspace-isolated Feishu channel adapter for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-harness-evoforge/dsh-evoforge.git",
    "directory": "packages/dsh-feishu"
  },
  "homepage": "https://github.com/deepseek-harness-evoforge/dsh-evoforge#readme",
  "bugs": {
    "url": "https://github.com/deepseek-harness-evoforge/dsh-evoforge/issues"
  },
  "keywords": ["deepseek-harness", "dsh", "feishu", "lark", "assistant"],
  "files": ["dist", "cordis.patch.yml"],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --clean",
    "prepack": "pnpm run build",
    "pretest": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers 1"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "@larksuiteoapi/node-sdk": "1.73.0",
    "axios": "1.19.0",
    "https-proxy-agent": "7.0.6",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.5 <0.1.0",
    "@deepseek-ai/dsh-commands": ">=0.1.0-rc.5 <0.1.0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.5 <0.1.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.0-rc.5 <0.1.0",
    "@deepseek-ai/dsh-user-approval": ">=0.1.0-rc.5 <0.1.0",
    "dsh-channel-router": "0.1.0-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-brand": "0.1.0-rc.6",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-storage-domain": "0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.6",
    "@deepseek-ai/dsh-user-approval": "0.1.0-rc.6",
    "@types/node": "^22.20.0",
    "dsh-channel-router": "workspace:*",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
