{
  "name": "dsh-evolve-web",
  "version": "0.1.0-alpha.1",
  "description": "Interactive, KV-safe Web adapter for dsh-evolve",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-harness-evoforge/dsh-evoforge.git",
    "directory": "packages/dsh-evolve-web"
  },
  "homepage": "https://github.com/deepseek-harness-evoforge/dsh-evoforge#readme",
  "bugs": {
    "url": "https://github.com/deepseek-harness-evoforge/dsh-evoforge/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "agent",
    "evolution",
    "web"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build:evolve-peer": "pnpm --filter dsh-evolve build",
    "prebuild": "pnpm run build:evolve-peer",
    "build": "tsc -p tsconfig.json && tsdown && node ../../scripts/verify-node-artifacts.mjs packages/dsh-evolve-web/lib/index.js packages/dsh-evolve-web/lib/client.js",
    "prepack": "pnpm run build",
    "pretypecheck": "pnpm run build:evolve-peer",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "pretest": "pnpm run build:evolve-peer",
    "test": "vitest run"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.5",
    "dsh-control-center": "0.1.0-alpha.1",
    "dsh-evolve": "0.1.0-alpha.1",
    "react": ">=18.2.0 <19"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/dom": "^10.4.0",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "dsh-control-center": "workspace:*",
    "dsh-evolve": "workspace:*",
    "jsdom": "^26.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
