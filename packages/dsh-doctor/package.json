{
  "name": "dsh-doctor",
  "version": "0.1.0-alpha.1",
  "description": "Zero-token runtime readiness diagnostics for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-harness-evoforge/dsh-evoforge.git",
    "directory": "packages/dsh-doctor"
  },
  "homepage": "https://github.com/deepseek-harness-evoforge/dsh-evoforge#readme",
  "bugs": {
    "url": "https://github.com/deepseek-harness-evoforge/dsh-evoforge/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "diagnostics",
    "readiness"
  ],
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm run build",
    "pretest": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.0-rc.5 || 0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.5 || 0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.5 || 0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.0-rc.5 || 0.1.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.5 || 0.1.1-rc.2",
    "dsh-control-center": "0.1.0-alpha.1",
    "react": ">=18.2.0 <19"
  },
  "peerDependenciesMeta": {
    "dsh-control-center": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.0-rc.6",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-brand": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.0-rc.6",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.6",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "dsh-control-center": "workspace:*",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  }
}
