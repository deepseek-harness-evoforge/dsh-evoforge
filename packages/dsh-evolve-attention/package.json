{
  "name": "dsh-evolve-attention",
  "version": "0.1.0-alpha.1",
  "description": "Cache-safe Telegram and Feishu attention for actionable EvoForge reviews",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-harness-evoforge/dsh-evoforge.git",
    "directory": "packages/dsh-evolve-attention"
  },
  "homepage": "https://github.com/deepseek-harness-evoforge/dsh-evoforge#readme",
  "bugs": {
    "url": "https://github.com/deepseek-harness-evoforge/dsh-evoforge/issues"
  },
  "keywords": ["deepseek-harness", "dsh", "evolution", "telegram", "feishu", "attention"],
  "files": ["dist", "cordis.patch.yml", "README.md"],
  "scripts": {
    "build:channel-peers": "pnpm --filter dsh-gateway --filter dsh-telegram --filter dsh-feishu build",
    "prebuild": "pnpm run build:channel-peers",
    "build": "tsdown src/index.ts --format esm --clean",
    "prepack": "pnpm run build",
    "pretypecheck": "pnpm run build:channel-peers",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm run build:channel-peers",
    "test": "vitest run"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "dsh-evolve": ">=0.1.0-alpha.1 <0.2.0",
    "dsh-feishu": ">=0.1.0-alpha.1 <0.2.0",
    "dsh-telegram": ">=0.1.0-alpha.1 <0.2.0"
  },
  "peerDependenciesMeta": {
    "dsh-feishu": { "optional": true },
    "dsh-telegram": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@types/node": "^22.20.0",
    "dsh-evolve": "workspace:*",
    "dsh-feishu": "workspace:*",
    "dsh-telegram": "workspace:*",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
