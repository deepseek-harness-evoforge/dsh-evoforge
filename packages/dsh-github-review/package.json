{
  "name": "dsh-github-review",
  "version": "0.1.0-alpha.1",
  "description": "Cache-stable GitHub Draft PR review follow-up for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-harness-evoforge/dsh-evoforge.git",
    "directory": "packages/dsh-github-review"
  },
  "homepage": "https://github.com/deepseek-harness-evoforge/dsh-evoforge#readme",
  "bugs": {
    "url": "https://github.com/deepseek-harness-evoforge/dsh-evoforge/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "github",
    "pull-request",
    "code-review"
  ],
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --clean",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.5 <0.1.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.5 <0.1.0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.5 <0.1.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.0-rc.5 <0.1.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.5 <0.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-storage": "0.1.0-rc.6",
    "@deepseek-ai/dsh-storage-domain": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
