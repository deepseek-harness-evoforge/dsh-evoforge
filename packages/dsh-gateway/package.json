{
  "name": "dsh-gateway",
  "version": "0.1.0-alpha.1",
  "description": "Fail-closed channel routing and delivery gateway for native DeepSeek Harness adapters",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./client": "./dist/client.js",
    "./client-types": {
      "types": "./lib/types/client-types.d.ts",
      "default": "./dist/client-types.mjs"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-harness-evoforge/dsh-evoforge.git",
    "directory": "packages/dsh-gateway"
  },
  "homepage": "https://github.com/deepseek-harness-evoforge/dsh-evoforge#readme",
  "bugs": {
    "url": "https://github.com/deepseek-harness-evoforge/dsh-evoforge/issues"
  },
  "keywords": ["deepseek-harness", "dsh", "workspace", "channel", "gateway"],
  "files": [
    "dist",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "lib/typert.source.sha256",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -b ../../tsconfig.host.json --force && tsdown && node ../../scripts/verify-gateway-typert-artifacts.mjs && node ../../scripts/verify-node-artifacts.mjs packages/dsh-gateway/dist/index.mjs packages/dsh-gateway/dist/client.js",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-attachment": ">=0.1.0-rc.5 <0.1.0",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.5 <0.1.0",
    "@deepseek-ai/dsh-agent-presets": ">=0.1.0-rc.5 <0.1.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.0-rc.5 <0.1.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.5 <0.1.0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.0-rc.5 <0.1.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.5 <0.1.0",
    "@deepseek-ai/dsh-commands": ">=0.1.0-rc.5 <0.1.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.5 <0.1.0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.5 <0.1.0",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.0-rc.5 <0.1.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.0-rc.5 <0.1.0",
    "@deepseek-ai/dsh-workspace": ">=0.1.0-rc.5 <0.1.0",
    "react": ">=18.2.0 <19"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.6",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-presets": "0.1.0-rc.6",
    "@deepseek-ai/dsh-api-remotes": "0.1.0-rc.6",
    "@deepseek-ai/dsh-brand": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.6",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence": "0.1.0-rc.6",
    "@deepseek-ai/dsh-storage-domain": "0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.6",
    "@deepseek-ai/dsh-workspace": "0.1.0-rc.6",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "jsdom": "^26.0.0",
    "react": "^18.2.0",
    "react-dom": "^19.2.8",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  }
}
